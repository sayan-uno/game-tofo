{
  "name": "tofo-games-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/sync-shared.mjs --target=frontend",
    "dev": "vite",
    "prebuild": "node ../scripts/sync-shared.mjs --target=frontend",
    "build": "tsc --noEmit && vite build",
