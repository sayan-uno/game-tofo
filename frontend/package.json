    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babylonjs/core": "^7.26.0",
    "@babylonjs/gui": "^7.26.0",
    "@babylonjs/loaders": "^7.26.0",
    "livekit-client": "^2.5.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
