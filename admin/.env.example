# Where the console API is.
#
# EMPTY  = call my own origin; the dev server proxies it to ADMIN_API_ORIGIN.
#          One origin, no CORS, one forwarded port. This is the dev setting.
# A URL  = call that host directly. This is the production setting, e.g.
#          VITE_ADMIN_API_URL=https://gadmin-api.tofo.in
VITE_ADMIN_API_URL=

# Dev only — where the proxy sends those calls. Ignored in production.
ADMIN_API_ORIGIN=http://localhost:4031

# The secret path segment the console API is mounted under (backend ADMIN_PATH).
# Not a secret from the browser — it has to build the URL — only from scanners.
VITE_ADMIN_PATH=your-secret-path

# The same Google OAuth client as the game. This app's ORIGIN must be listed in
# that client's "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Dev only. The asset CDN's CORS policy names specific origins and the console
# is not one of them, so the replay studio fetches pack files and character
# models through the dev server instead. In production LEAVE THIS EMPTY and add
# the console's origin to the R2 bucket's CORS rules, or Trackline replays will
# not load.
VITE_CDN_PROXY_PREFIX=/__cdn
CDN_PROXY_TARGET=https://cdn.tofo.in
