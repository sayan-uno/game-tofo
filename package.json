{
  "name": "tofo-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n shared,backend,frontend -c magenta,blue,green \"node scripts/sync-shared.mjs --watch\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:admin": "concurrently -n admin-api,admin-ui -c blue,magenta \"ROLE=admin PORT=4031 npm --prefix backend run dev\" \"npm --prefix admin run dev\"",
    "dev:recorder": "ROLE=recorder npm --prefix backend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install && npm --prefix admin install",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check",
    "check:sim": "backend/node_modules/.bin/tsx tools/checks/trackline-sim.ts",
    "check:ludo": "backend/node_modules/.bin/tsx tools/checks/ludo-sim.ts",
    "check:ops": "backend/node_modules/.bin/tsx tools/checks/ops.mts",
    "check:admin": "backend/node_modules/.bin/tsx tools/checks/admin.mts",
    "check:replay": "backend/node_modules/.bin/tsx tools/checks/replay.mts",
    "check:voice": "backend/node_modules/.bin/tsx tools/checks/voice.mts",
    "check:lobbyui": "backend/node_modules/.bin/tsx tools/checks/lobby-ui.mts",
    "check:reports": "backend/node_modules/.bin/tsx tools/checks/reports.mts",
    "check:analytics": "backend/node_modules/.bin/tsx tools/checks/analytics.mts",
    "check:recorder": "python3 tools/checks/recorder.py",
    "e2e:enforcement": "backend/node_modules/.bin/tsx tools/e2e/enforcement.mts",
    "e2e:admin": "backend/node_modules/.bin/tsx tools/e2e/admin-signin.mts",
    "e2e:party": "backend/node_modules/.bin/tsx tools/e2e/party-lifecycle.mts",
    "e2e:console": "python3 tools/e2e/test_admin_console.py",
    "pack:build": "node tools/packs/build.mjs",
    "pack:upload": "node tools/packs/upload.mjs",
    "pack:sources": "node tools/packs/sources.mjs",
    "pack:restore": "node tools/packs/restore.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
