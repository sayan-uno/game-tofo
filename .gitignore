node_modules/
dist/
*.log
.env
.env.local
.DS_Store

# Raw Meshy exports staged for the character pipeline. 60–270 MB each and
# always derived — the shipped asset lives on the CDN, never in git.
glb/
*.glb

# Generated copies of /shared (see shared/README.md) — regenerated by every
# dev/build/typecheck script; the source of truth is /shared.
frontend/src/shared/
backend/src/shared/

# Evidence written by a development machine when no R2 evidence bucket is
# configured: match replays, and later voice recordings. Never committed —
# in production these live in a private bucket (see backend/src/platform/
# evidence.ts, which says at boot which of the two it is using).
backend/.evidence/

# Built game packs (uploaded to the CDN, never committed).
tools/packs/out/

# A pack's binaries — the optimised models and textures it ships, and the raw
# generator art they are made from. None of it belongs in git: it is 8+ MB of
# binaries that would double the repo, and every one of those bytes already
# lives on R2 (the pack payload under games/<id>/<version>/, the raw art under
# sources/<id>/). Git keeps the CODE that builds them; one command brings the
# binaries back:
#
#   npm run pack:restore trackline
#
# This is the same rule the character pipeline already follows above.
tools/packs/*/src/models/
tools/packs/*/src/textures/
tools/packs/*/art/*_raw.*

# Screenshots from the look-at-it checks (tools/checks/social-look.py and
# friends). They are evidence for one run on one machine, not a record — the
# thing worth committing is the script that produces them.
tools/checks/.out/
