# ===== TOFO Games — Backend environment =====
# Fill these in, then run: npm run db:migrate (from backend/) and npm run dev

# Server
PORT=4000

# URL of the frontend (for CORS). When you host frontend separately,
# change this to your deployed frontend URL, e.g. https://play.tofogames.com
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
# e.g. postgresql://user:password@host:5432/tofogames
DATABASE_URL=

# Redis connection string
# e.g. redis://default:password@host:6379
REDIS_URL=

# Google OAuth — from https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" of type "Web application".
# Authorized JavaScript origins: http://localhost:5173 (and your prod frontend URL later)
# Later, when native Android/iOS apps exist, add their client IDs here too,
# comma-separated, WEB ID FIRST: webid,androidid,iosid
GOOGLE_CLIENT_ID=

# JWT signing secret — any long random string (e.g. run: openssl rand -hex 32)
JWT_SECRET=

# LiveKit — from https://cloud.livekit.io (or your self-hosted server)
# LIVEKIT_URL looks like: wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Admin console (A0) ----
# How many reverse proxies sit in front of this process.
#   0 = believe no headers, use the socket address (the safe default: an
#       attacker-controlled IP in an evidence log is worse than no IP).
#   1 = behind Cloudflare or one reverse proxy — CF-Connecting-IP / the last
#       X-Forwarded-For hop is then trusted.
TRUSTED_PROXY_HOPS=0

# Signs commands the admin process sends to the game process over Redis.
# Reaching Redis is then not the same as being allowed to ban people.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_HMAC_SECRET=

# "game" (default) or "admin". An admin process serves the console API and must
# never run the sockets or the matchmaker — see src/index.ts for why.
# ROLE=game

# ---- Admin console (A1) ----
# The console is mounted under this path segment only; everything else 404s.
# Obscurity, not security — with Cloudflare Access in front it adds nothing and
# can be any value you will remember.
ADMIN_PATH=your-secret-path

# MUST differ from JWT_SECRET. Admin tokens carry aud:"admin", so a player
# token can never be accepted here, nor an admin token by the game.
ADMIN_JWT_SECRET=

# 32 bytes of hex. Encrypts TOTP secrets at rest.
TOTP_ENC_KEY=

# Creates the first owner — ONLY while admin_users is empty.
ADMIN_BOOTSTRAP_EMAIL=

# Where the console UI is served from (the only origin allowed to call the API).
ADMIN_ORIGIN=http://localhost:5174

# Login alerts. Optional but strongly recommended: a channel that is NOT the
# inbox your recovery codes would arrive in.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Cloudflare Access, once it is in front. Set BOTH to make it mandatory.
# CF_ACCESS_TEAM=your-team
# CF_ACCESS_AUD=


# ---- Evidence bucket (A4+) ----
# The PRIVATE R2 bucket for match replays, and later voice recordings and
# archived logs. NOT the bucket the asset packs live in — that one is
# world-readable and its token is handed to a build script.
# Unset (as now) means replays are written to backend/.evidence instead, which
# is right for this machine and wrong for a server. The process says which it
# is doing at boot, and the console shows a banner.
# R2_EVIDENCE_ACCOUNT_ID=
# R2_EVIDENCE_BUCKET=tofo-evidence
# R2_EVIDENCE_ACCESS_KEY_ID=
# R2_EVIDENCE_SECRET_ACCESS_KEY=

# ---- Voice recording (A6) ----
# OFF unless this is exactly "true". Recording a flagged player also records
# everyone in the room with them — in matches AND in their party — so this must
# not switch on before a published Terms & Privacy page has told players it can
# happen.
# It also needs the R2_EVIDENCE_* values above, and a recorder process
# (ROLE=recorder) running somewhere. The console says which piece is missing.
# VOICE_RECORDING_ENABLED=true
# Keep a single mixed file of everyone in the room (how a conversation is
# followed), and/or every voice separately (how "who said it" is answered).
# Both are on by default; either can be turned off to halve the storage.
# VOICE_MIX=false
# VOICE_SEPARATE_TRACKS=false
# A hard ceiling on ONE recording. A match ends by itself; a party does not.
# Nothing is lost when it fires: the file is closed and kept, and the next
# thing they say opens a new one.
# VOICE_MAX_SESSION_MINUTES=120
# VOICE_RETENTION_DAYS=90

# ---- The recorder (ROLE=recorder) ----
# A separate process that joins recorded rooms as a HIDDEN LiveKit participant
# and writes the files itself. It replaced LiveKit's egress, whose concurrency
# is capped per project (2 on the free plan, 500 at $500/month) — a ceiling set
# by somebody else's price list. This one is capped by CPU: roughly a tenth of
# a core per recorded match.
#
# It serves no HTTP and needs no port. Deploy it as its own service with the
# same DATABASE_URL, REDIS_URL, LIVEKIT_* and R2_EVIDENCE_* values.
#
# How often a part-written file is pushed to the bucket. A crash costs at most
# this much audio, so it is a directly chosen risk.
# RECORDER_FLUSH_SECONDS=30
# A brake, not a licence limit: one process refuses to hold more than this.
# RECORDER_MAX_SESSIONS=50
# Running several recorders: give each one a different SHARD and the same
# SHARDS, and they split the sessions between them. One instance takes all.
# RECORDER_SHARD=0
# RECORDER_SHARDS=1
